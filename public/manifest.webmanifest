{
  "name": "SynkNode Secure Transfer",
  "short_name": "SynkNode",
  "description": "Secure peer-to-peer file transfer and private storage.",
  "start_url": "/?view=transfer",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f7ff",
  "theme_color": "#ff6427",
  "icons": [
    { "src": "/favicon.ico", "sizes": "any", "type": "image/x-icon", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": {
        "name": "files",
        "accept": ["*/*", "image/*", "video/*", "audio/*", "text/*", "application/pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".zip", ".csv"]
      }
    }
  },
  "shortcuts": [
    { "name": "Send files", "short_name": "Send", "url": "/?view=transfer" },
    { "name": "Incoming shares", "short_name": "Incoming", "url": "/incoming-shares" },
    { "name": "My Space", "short_name": "Storage", "url": "/space" }
  ]
}
