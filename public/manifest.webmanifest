{
  "name": "SynkNode Secure Transfer",
  "short_name": "SynkNode",
  "description": "Secure peer-to-peer file transfer and private storage.",
  "start_url": "/?view=transfer",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f7ff",
  "theme_color": "#ff6427",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": "files" }
  },
  "shortcuts": [
    { "name": "Send files", "short_name": "Send", "url": "/?view=transfer" },
    { "name": "My Space", "short_name": "Storage", "url": "/space" }
  ]
}
